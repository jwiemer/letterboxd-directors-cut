diff --git a/.github/workflows/safari.yml b/.github/workflows/safari.yml
new file mode 100644
index 0000000..aca6bbc
--- /dev/null
+++ b/.github/workflows/safari.yml
@@ -0,0 +1,31 @@
+name: Safari iOS
+
+on:
+  pull_request:
+    paths: ['src/**', 'safari/**', 'testing/safari/**', '.github/workflows/safari.yml']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: macos-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - name: Build and check Safari resources
+        working-directory: src
+        run: |
+          npm install --no-audit --no-fund
+          ./build.sh safari
+          npm run test-safari
+      - name: Build iOS app and extension
+        run: |
+          xcodebuild -project 'safari/Directors Cut/Directors Cut.xcodeproj' \
+            -scheme 'Directors Cut' -configuration Debug -sdk iphonesimulator \
+            -destination 'generic/platform=iOS Simulator' \
+            -derivedDataPath "$RUNNER_TEMP/directors-cut-derived" \
+            CODE_SIGNING_ALLOWED=NO build
